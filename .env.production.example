# This is a configuration template, never an active credential file.
# Required blanks deliberately make docker compose config/start fail closed.
APP_DOMAIN=
ACME_EMAIL=
ORGANIZATION_NAME=
CURRENCY=EUR
TIMEZONE=Europe/Berlin
SUPPORT_EMAIL=
ORGANIZATION_ADDRESS=
PRIVACY_CONTACT=
RETENTION_DAYS=365
BACKEND_IMAGE=
FRONTEND_IMAGE=
POSTGRES_PASSWORD=
# Runtime must use a least-privilege account; see ops/database-role.sql.
# Example: postgres://foodlink_app:<URL-encoded-app-password>@db:5432/foodlink
DATABASE_URL=
# Schema owner example: postgres://foodlink:<URL-encoded-POSTGRES_PASSWORD>@db:5432/foodlink
MIGRATION_DATABASE_URL=
S3_ENDPOINT=
S3_REGION=
S3_FORCE_PATH=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
