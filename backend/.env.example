NODE_ENV=development
PORT=8080
TRUST_PROXY=0
DATABASE_URL=postgres://foodlink:foodlink@localhost:5432/foodlink
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173
COOKIE_SECURE=false
MIGRATE_ON_START=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH=true
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=foodlink
AUTO_CREATE_BUCKET=true
# Native development records email in the outbox. Docker uses private Mailpit SMTP.
MAIL_MODE=outbox
MAIL_FROM=FoodLink <noreply@foodlink.local>
PAYMENTS_ENABLED=false
